# Build Electron (file://) tidak bisa pakai URL relatif /api (itu buat nginx/docker web).
# Pakai IP BACKEND API
VITE_API_URL=http://rsv-server.local:8000/api
VITE_WS_URL=ws://rsv-server.local:8000
