# =========================
# Build React
# =========================
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

# Firebase Web SDK (nilai publik). Bisa diisi lewat --build-arg atau .env.production.
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_MESSAGING_SENDER_ID
ARG VITE_FIREBASE_APP_ID

COPY . .

# Build args kosong tidak boleh menimpa nilai dari .env.production.
RUN for name in VITE_FIREBASE_API_KEY VITE_FIREBASE_AUTH_DOMAIN VITE_FIREBASE_PROJECT_ID \
      VITE_FIREBASE_STORAGE_BUCKET VITE_FIREBASE_MESSAGING_SENDER_ID VITE_FIREBASE_APP_ID; do \
      eval "value=\$$name"; \
      if [ -z "$value" ]; then unset "$name"; fi; \
    done && npm run build


# =========================
# Nginx
# =========================
FROM nginx:alpine

COPY --from=builder /app/dist/app /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]