generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

generator erd {
  provider = "prisma-erd-generator"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleRef Role @relation("UserRole", fields: [role], references: [kode], onDelete: Restrict)
  riwayatMutasiGudang RiwayatMutasiGudang[]
  stokItemMutasi      StokItemMutasi[]
  stokOpnameSesi      StokOpnameSesi[]

  @@index([role], map: "User_role_fkey")
}

// =============================================
// RBAC: role master + permission master + matriks akses
// Kode role/permission disimpan lowercase; input API dinormalisasi
// supaya "ADMIN" dan "admin" menunjuk role yang sama.
// =============================================

model Role {
  id        Int      @id @default(autoincrement())
  kode      String   @unique
  nama      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]                       @relation("UserRole")
  permissions  RolePermission[]
  barangStatus RoleBarangStatusPermission[]
}

model Permission {
  id        Int      @id @default(autoincrement())
  kode      String   @unique
  nama      String
  kelompok  String   @default("BARANG")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
}

// Grant permission tingkat aksi ke sebuah role. Baris hilang otomatis saat
// role atau permission dihapus.
model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "RolePermission_permissionId_fkey")
}

// Visibilitas per status barang. STATUS_ADMIN (lihat middleware/auth.ts)
// melewati matriks ini dan selalu melihat semua status.
model RoleBarangStatusPermission {
  roleId     Int
  statusKode String
  canView    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  role   Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  status StatusBarang @relation(fields: [statusKode], references: [kode], onDelete: Cascade)

  @@id([roleId, statusKode])
  @@index([statusKode], map: "RoleBarangStatusPermission_statusKode_fkey")
}

model Product {
  id        Int      @id @default(autoincrement())
  nama      String
  prefix    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model Style {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model Color {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model Karyawan {
  id        Int      @id @default(autoincrement())
  nama      String
  jabatan   String
  divisiId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  divisi Divisi? @relation(fields: [divisiId], references: [id], onDelete: SetNull)

  @@index([divisiId])
}

// Divisi lini produksi (1:1 dengan tahap jadwal: buffing, baseCoat, ...).
// Dipakai pengelompokan karyawan dan pembuatan SPK per divisi.
model Divisi {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  karyawan Karyawan[]
  items    Item[]
}


model Item {
  id        Int      @id @default(autoincrement())
  kode      String   @unique
  nama      String
  divisiId  Int?
  unit      String   @default("pcs")
  jenis     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  divisi Divisi? @relation(fields: [divisiId], references: [id], onDelete: SetNull)
  permintaanItems PermintaanBarangItem[]
  stokMutasi      StokItemMutasi[]
  opnameBaris     StokOpnameBaris[]

  @@index([divisiId], map: "Item_divisiId_fkey")
}

// =============================================
// Master Gudang (lokasi penyimpanan)
// Jumlah barang dihitung via _count, bukan kolom stok.
// =============================================

model Gudang {
  id        Int      @id @default(autoincrement())
  kode      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barang       Barang[]
  mutasiKeluar RiwayatMutasiGudang[] @relation("MutasiGudangAsal")
  mutasiMasuk  RiwayatMutasiGudang[] @relation("MutasiGudangTujuan")
}

// Riwayat perpindahan lokasi barang. Append-only: tidak ada
// endpoint ubah/hapus; koreksi dilakukan lewat mutasi balik.
model RiwayatMutasiGudang {
  id             Int      @id @default(autoincrement())
  barangId       Int
  gudangAsalId   Int?
  gudangTujuanId Int?
  jumlah         Int      @default(1)
  tanggal        DateTime @default(now())
  keterangan     String?
  userId         Int?
  createdAt      DateTime @default(now())

  barang       Barang  @relation(fields: [barangId], references: [id], onDelete: Restrict)
  gudangAsal   Gudang? @relation("MutasiGudangAsal", fields: [gudangAsalId], references: [id], onDelete: SetNull)
  gudangTujuan Gudang? @relation("MutasiGudangTujuan", fields: [gudangTujuanId], references: [id], onDelete: SetNull)
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([barangId, tanggal])
  @@index([gudangAsalId], map: "RiwayatMutasiGudang_gudangAsalId_fkey")
  @@index([gudangTujuanId], map: "RiwayatMutasiGudang_gudangTujuanId_fkey")
  @@index([userId], map: "RiwayatMutasiGudang_userId_fkey")
}

model Size {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model ProductVariant {
  id          Int      @id @default(autoincrement())
  kodeVariant String   @unique

  productId Int
  styleId   Int
  colorId   Int
  sizeId    Int

    tanggal    DateTime? @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  style   Style   @relation(fields: [styleId], references: [id], onDelete: Restrict)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Restrict)
  size    Size    @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  barang         Barang[]
  barangCounters BarangCounter[]
  orderItems     ProductionOrderItem[]
  realizations   ProductionRealization[]
  scheduleAllocEdits ProductionScheduleAllocEdit[]

  @@unique([productId, styleId, colorId, sizeId])
  @@index([productId])
  @@index([styleId])
  @@index([colorId])
  @@index([sizeId])
}

// =============================================
// Production Batch
// =============================================

enum StatusBatch {
  AKTIF
  SELESAI
}

model ProductionBatch {
  id            Int         @id @default(autoincrement())
  nomorBatch    Int         @unique
  totalProduksi Int         @default(0)
  kapasitas     Int         @default(5000)
  status        StatusBatch @default(AKTIF)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  barang         Barang[]
  barangCounters BarangCounter[]

  @@index([status])
}

// =============================================
// Status Barang (master dinamis — CRUD via /api/status-barang)
// =============================================

model StatusBarang {
  id        Int      @id @default(autoincrement())
  kode      String   @unique
  nama      String
  warna     String?
  urutan    Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barang  Barang[]        @relation("BarangStatus")
  riwayat RiwayatBarang[] @relation("RiwayatStatus")
  transisiDari StatusTransition[] @relation("TransitionFrom")
  transisiKe   StatusTransition[] @relation("TransitionTo")
  rolePermissions RoleBarangStatusPermission[]
}

// Transisi status barang yang diizinkan. Kosong untuk suatu fromKode =
// transisi dari status itu diizinkan ke semua (lihat model/barang).
model StatusTransition {
  id       Int    @id @default(autoincrement())
  fromKode String
  toKode   String

  from StatusBarang @relation("TransitionFrom", fields: [fromKode], references: [kode], onDelete: Cascade)
  to   StatusBarang @relation("TransitionTo", fields: [toKode], references: [kode], onDelete: Cascade)

  @@unique([fromKode, toKode])
  @@index([fromKode])
  @@index([toKode])
}

// =============================================
// Grup barang (1 grup = banyak barang)
// =============================================

model BarangGroup {
  id        Int      @id @default(autoincrement())
  nama      String
  isArsip   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barang Barang[]
}

model Barang {
  id         Int      @id @default(autoincrement())
  kodeBarang String   @unique
  variantId  Int
  batchId    Int?
  groupId    Int?
  gudangId   Int?
  tanggal    DateTime?
  status     String   @default("REGISTER")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant   ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batch     ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  group     BarangGroup?     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  gudang    Gudang?          @relation(fields: [gudangId], references: [id], onDelete: SetNull)
  statusRef StatusBarang     @relation("BarangStatus", fields: [status], references: [kode])
  riwayat   RiwayatBarang[]
  riwayatMutasiGudang RiwayatMutasiGudang[]

  @@index([variantId])
  @@index([batchId])
  @@index([groupId])
  @@index([gudangId], map: "Barang_gudangId_fkey")
  @@index([status])
}

model RiwayatBarang {
  id         Int      @id @default(autoincrement())
  barangId   Int
  status     String
  tanggal    DateTime @default(now())
  keterangan String?

  barang    Barang       @relation(fields: [barangId], references: [id], onDelete: Restrict)
  statusRef StatusBarang @relation("RiwayatStatus", fields: [status], references: [kode])

  @@index([barangId])
  @@index([tanggal])
  @@index([status], map: "RiwayatBarang_status_fkey")
}

// =============================================
// BarangCounter
// Key: (batchId, variantId, tanggal)
// Reset otomatis karena tanggal/batch berbeda = baris baru
// =============================================

model BarangCounter {
  id           Int      @id @default(autoincrement())
  batchId      Int
  variantId    Int
  tanggal      DateTime
  currentCount Int      @default(0)

  batch   ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([batchId, variantId, tanggal])
  @@index([batchId])
  @@index([variantId])
}

// =============================================
// Production Order (Master Produksi)
// Sumber: Google Sheet "DATA MASTER PRODUKSI OKTOBER 2026"
// 1 order = 1 periode, N item (1 baris = 1 ProductVariant + qty)
// =============================================

enum StatusProductionOrder {
  DRAFT
  AKTIF
  SELESAI
  BATAL
}

model ProductionOrder {
  id        Int                   @id @default(autoincrement())
  nomor     String                @unique
  periode   String
  label     String?
  totalQty  Int                   @default(0)
  status    StatusProductionOrder @default(AKTIF)
  mulaiProduksi DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  items      ProductionOrderItem[]
  capacities ProductionCapacity[]
  realizations ProductionRealization[]
  realizationStages ProductionRealizationStage[]
  scheduleTargetEdits ProductionScheduleTargetEdit[]
  scheduleAllocEdits ProductionScheduleAllocEdit[]

  @@index([periode])
  @@index([status])
}

model ProductionOrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  variantId Int
  qty       Int      @default(0)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([orderId])
  @@index([variantId])
}

// =============================================
// Realisasi produksi harian per item variant.
// 1 baris = aktual pcs 1 variant pada 1 tanggal dalam 1 order.
// Rencana harian dibaca dari jadwal (GET schedule), bukan disimpan.
// =============================================

model ProductionRealization {
  id        Int      @id @default(autoincrement())
  orderId   Int
  variantId Int
  tanggal   DateTime
  qty       Int      @default(0)
  reject    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId, tanggal])
  @@index([orderId, tanggal])
  @@index([variantId], map: "ProductionRealization_variantId_fkey")
}

// Realisasi harian per tahap lini (agregat per hari, bukan per variant).
// stage: buffing | baseCoat | decalSolid | decalMotif | topCoat | perakitan | qc.

model ProductionRealizationStage {
  id        Int      @id @default(autoincrement())
  orderId   Int
  tanggal   DateTime
  stage     String
  qty       Int      @default(0)
  reject    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, tanggal, stage])
  @@index([orderId, tanggal])
}

// =============================================
// Kapasitas Produksi per tahap per order
// Field 1:1 dengan sheet "PERHITUNGAN KAPASITAS PRODUKSI".
// hariKerja & totalKapasitas disimpan mentah (input manual),
// bukan hasil kalkulasi backend.
// =============================================

model ProductionCapacity {
  id               Int      @id @default(autoincrement())
  orderId          Int
  stage            String
  kapasitasWeekday Int      @default(0)
  kapasitasSabtu   Int      @default(0)
  mulai            DateTime?
  selesai          DateTime?
  hariKerja        Int      @default(0)
  totalKapasitas   Int      @default(0)
  catatan          String?
  urutan           Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, stage])
  @@index([orderId])
}

// =============================================
// Override edit jadwal otomatis per order.
// buildSchedule tetap mesin hitung; GET schedule menerapkan delta ini.
// qty null tidak disimpan — hapus baris = kembali ke angka auto.
// =============================================

model ProductionScheduleTargetEdit {
  id        Int      @id @default(autoincrement())
  orderId   Int
  tanggal   DateTime
  stage     String
  qty       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, tanggal, stage])
  @@index([orderId, tanggal])
}

model ProductionScheduleAllocEdit {
  id        Int      @id @default(autoincrement())
  orderId   Int
  variantId Int
  tanggal   DateTime
  qty       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, tanggal, variantId])
  @@index([orderId, tanggal])
  @@index([variantId], map: "ProductionScheduleAllocEdit_variantId_fkey")
}

enum StatusApprovalPermintaan {
  BELUM_DISETUJUI
  DISETUJUI
}

enum StatusKeputusanItem {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

enum TipeStokItem {
  MASUK
  KELUAR
}

// Ledger stok item master (append-only). Saldo = SUM(MASUK) - SUM(KELUAR).
// Koreksi dilakukan dengan baris pembalik, tidak pernah ubah/hapus.
model StokItemMutasi {
  id                      Int      @id @default(autoincrement())
  itemId                  Int
  tipe                    TipeStokItem
  jumlah                  Int
  sumberPermintaanItemId  Int?
  sumberOpnameBarisId    Int?
  keterangan              String?
  userId                  Int?
  tanggal                 DateTime @default(now())
  createdAt               DateTime @default(now())

  item           Item                  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  sumberPermintaan PermintaanBarangItem? @relation(fields: [sumberPermintaanItemId], references: [id], onDelete: SetNull)
  sumberOpname   StokOpnameBaris?      @relation(fields: [sumberOpnameBarisId], references: [id], onDelete: SetNull)
  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId, tanggal])
  @@index([sumberPermintaanItemId], map: "StokItemMutasi_sumberPermintaanItemId_fkey")
  @@index([sumberOpnameBarisId], map: "StokItemMutasi_sumberOpnameBarisId_fkey")
  @@index([userId], map: "StokItemMutasi_userId_fkey")
}

// Stok opname massal: satu sesi berisi banyak baris hitung fisik.
// Baris selalu disimpan (termasuk selisih 0) sebagai bukti sudah dihitung.
// Selisih != 0 otomatis membuat baris ledger penyeimbang (MASUK/KELUAR).
model StokOpnameSesi {
  id         Int      @id @default(autoincrement())
  tanggal    DateTime @default(now())
  keterangan String?
  userId     Int?
  createdAt  DateTime @default(now())

  user  User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  baris StokOpnameBaris[]

  @@index([tanggal])
  @@index([userId], map: "StokOpnameSesi_userId_fkey")
}

model StokOpnameBaris {
  id         Int @id @default(autoincrement())
  sesiId     Int
  itemId     Int
  stokSistem Int
  stokFisik  Int
  selisih    Int

  sesi   StokOpnameSesi @relation(fields: [sesiId], references: [id], onDelete: Cascade)
  item   Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  ledger StokItemMutasi[]

  @@unique([sesiId, itemId])
  @@index([itemId], map: "StokOpnameBaris_itemId_fkey")
}

// Permintaan barang/bahan baku dari departemen ke gudang (form FRM-PRD-001).
// Item bebas teks (bukan FK ProductVariant) karena dapat berupa bahan baku
// yang tidak ada di master variant.
model PermintaanBarang {
  id                Int                      @id @default(autoincrement())
  noPermintaan      String                   @unique
  tanggal           DateTime
  departemen        String
  namaPeminta       String
  kebutuhanUntuk    String                   @default("Produksi")
  prioritas         String                   @default("Normal")
  tanggalDibutuhkan DateTime?
  alasan            String                   @db.Text
  approval          StatusApprovalPermintaan @default(BELUM_DISETUJUI)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  items PermintaanBarangItem[]

  @@index([tanggal])
  @@index([approval])
}

model PermintaanBarangItem {
  id           Int      @id @default(autoincrement())
  permintaanId Int
  itemId          Int?
  nama            String
  spesifikasi     String?
  jumlah          Int
  satuan          String?
  statusKeputusan StatusKeputusanItem @default(MENUNGGU)
  jumlahDisetujui Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  permintaan PermintaanBarang @relation(fields: [permintaanId], references: [id], onDelete: Cascade)
  item       Item?            @relation(fields: [itemId], references: [id], onDelete: SetNull)
  stokMutasi StokItemMutasi[]

  @@index([permintaanId], map: "PermintaanBarangItem_permintaanId_fkey")
  @@index([itemId], map: "PermintaanBarangItem_itemId_fkey")
}