generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id        Int      @id @default(autoincrement())
  nama      String
  prefix    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model Style {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model Color {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model Size {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model ProductVariant {
  id          Int      @id @default(autoincrement())
  kodeVariant String   @unique

  productId Int
  styleId   Int
  colorId   Int
  sizeId    Int

    tanggal    DateTime? @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  style   Style   @relation(fields: [styleId], references: [id], onDelete: Restrict)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Restrict)
  size    Size    @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  barang         Barang[]
  barangCounters BarangCounter[]
  orderItems     ProductionOrderItem[]
  realizations   ProductionRealization[]

  @@unique([productId, styleId, colorId, sizeId])
  @@index([productId])
  @@index([styleId])
  @@index([colorId])
  @@index([sizeId])
}

// =============================================
// Production Batch
// =============================================

enum StatusBatch {
  AKTIF
  SELESAI
}

model ProductionBatch {
  id            Int         @id @default(autoincrement())
  nomorBatch    Int         @unique
  totalProduksi Int         @default(0)
  kapasitas     Int         @default(5000)
  status        StatusBatch @default(AKTIF)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  barang         Barang[]
  barangCounters BarangCounter[]

  @@index([status])
}

// =============================================
// Status Barang (master dinamis — CRUD via /api/status-barang)
// =============================================

model StatusBarang {
  id        Int      @id @default(autoincrement())
  kode      String   @unique
  nama      String
  warna     String?
  urutan    Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barang  Barang[]        @relation("BarangStatus")
  riwayat RiwayatBarang[] @relation("RiwayatStatus")
}

model Barang {
  id         Int      @id @default(autoincrement())
  kodeBarang String   @unique
  variantId  Int
  batchId    Int?
  tanggal    DateTime?
  status     String   @default("REGISTER")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant   ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batch     ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  statusRef StatusBarang     @relation("BarangStatus", fields: [status], references: [kode])
  riwayat   RiwayatBarang[]

  @@index([variantId])
  @@index([batchId])
  @@index([status])
}

model RiwayatBarang {
  id         Int      @id @default(autoincrement())
  barangId   Int
  status     String
  tanggal    DateTime @default(now())
  keterangan String?

  barang    Barang       @relation(fields: [barangId], references: [id], onDelete: Restrict)
  statusRef StatusBarang @relation("RiwayatStatus", fields: [status], references: [kode])

  @@index([barangId])
  @@index([tanggal])
  @@index([status], map: "RiwayatBarang_status_fkey")
}

// =============================================
// BarangCounter
// Key: (batchId, variantId, tanggal)
// Reset otomatis karena tanggal/batch berbeda = baris baru
// =============================================

model BarangCounter {
  id           Int      @id @default(autoincrement())
  batchId      Int
  variantId    Int
  tanggal      DateTime
  currentCount Int      @default(0)

  batch   ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([batchId, variantId, tanggal])
  @@index([batchId])
  @@index([variantId])
}

// =============================================
// Production Order (Master Produksi)
// Sumber: Google Sheet "DATA MASTER PRODUKSI OKTOBER 2026"
// 1 order = 1 periode, N item (1 baris = 1 ProductVariant + qty)
// =============================================

enum StatusProductionOrder {
  DRAFT
  AKTIF
  SELESAI
  BATAL
}

model ProductionOrder {
  id        Int                   @id @default(autoincrement())
  nomor     String                @unique
  periode   String
  label     String?
  totalQty  Int                   @default(0)
  status    StatusProductionOrder @default(AKTIF)
  mulaiProduksi DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  items      ProductionOrderItem[]
  capacities ProductionCapacity[]
  realizations ProductionRealization[]
  realizationStages ProductionRealizationStage[]

  @@index([periode])
  @@index([status])
}

model ProductionOrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  variantId Int
  qty       Int      @default(0)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([orderId])
  @@index([variantId])
}

// =============================================
// Realisasi produksi harian per item variant.
// 1 baris = aktual pcs 1 variant pada 1 tanggal dalam 1 order.
// Rencana harian dibaca dari jadwal (GET schedule), bukan disimpan.
// =============================================

model ProductionRealization {
  id        Int      @id @default(autoincrement())
  orderId   Int
  variantId Int
  tanggal   DateTime
  qty       Int      @default(0)
  reject    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId, tanggal])
  @@index([orderId, tanggal])
  @@index([variantId], map: "ProductionRealization_variantId_fkey")
}

// Realisasi harian per tahap lini (agregat per hari, bukan per variant).
// stage: buffing | baseCoat | decalSolid | decalMotif | topCoat | perakitan | qc.

model ProductionRealizationStage {
  id        Int      @id @default(autoincrement())
  orderId   Int
  tanggal   DateTime
  stage     String
  qty       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, tanggal, stage])
  @@index([orderId, tanggal])
}

// =============================================
// Kapasitas Produksi per tahap per order
// Field 1:1 dengan sheet "PERHITUNGAN KAPASITAS PRODUKSI".
// hariKerja & totalKapasitas disimpan mentah (input manual),
// bukan hasil kalkulasi backend.
// =============================================

model ProductionCapacity {
  id               Int      @id @default(autoincrement())
  orderId          Int
  stage            String
  kapasitasWeekday Int      @default(0)
  kapasitasSabtu   Int      @default(0)
  mulai            DateTime?
  selesai          DateTime?
  hariKerja        Int      @default(0)
  totalKapasitas   Int      @default(0)
  catatan          String?
  urutan           Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, stage])
  @@index([orderId])
}