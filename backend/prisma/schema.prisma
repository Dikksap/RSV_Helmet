generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

enum WipRejectStatus {
  OPEN
  IN_PROGRESS
  WAITING_QC
  COMPLETED
}

generator erd {
  provider = "prisma-erd-generator"
}

model QualityRejectReason {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(191)
  isActive    Boolean  @default(true)
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User       @relation("QualityRejectReasonCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  rejects   WipReject[]
}

model WipReject {
  id               Int            @id @default(autoincrement())
  number           String         @unique
  itemId           Int
  quantity         Decimal        @db.Decimal(18, 6)
  reasonId         Int
  repairDivisionId Int
  repairStageId    Int?
  recordedById     Int
  claimedById      Int?
  status           WipRejectStatus @default(OPEN)
  createdAt        DateTime       @default(now())
  claimedAt        DateTime?
  completedAt      DateTime?

  item           Item        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  reason         QualityRejectReason @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  repairDivision Divisi      @relation(fields: [repairDivisionId], references: [id], onDelete: Restrict)
  repairStage    ProductionRoutingStage? @relation("WipRejectRepairStage", fields: [repairStageId], references: [id], onDelete: Restrict)
  recordedBy     User        @relation("WipRejectRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  claimedBy      User?       @relation("WipRejectClaimedBy", fields: [claimedById], references: [id], onDelete: Restrict)
  lots           WipRejectLot[]
  attempts       WipRejectRepairAttempt[]

  @@index([repairDivisionId, status, createdAt])
  @@index([repairStageId])
  @@index([itemId, createdAt])
  @@index([reasonId])
  @@index([recordedById])
  @@index([claimedById])
}

model WipRejectLot {
  id                      Int     @id @default(autoincrement())
  rejectId                Int
  pemakaianMaterialItemId Int
  quantity                Decimal @db.Decimal(18, 6)

  reject                WipReject             @relation(fields: [rejectId], references: [id], onDelete: Restrict)
  pemakaianMaterialItem PemakaianMaterialItem @relation(fields: [pemakaianMaterialItemId], references: [id], onDelete: Restrict)
  repairAllocations     WipRejectRepairLot[]

  @@unique([rejectId, pemakaianMaterialItemId])
  @@index([pemakaianMaterialItemId])
}

model WipRejectRepairAttempt {
  id                Int      @id @default(autoincrement())
  rejectId          Int
  performedById     Int
  quantityAttempted Decimal  @db.Decimal(18, 6)
  quantityRepaired  Decimal  @db.Decimal(18, 6)
  notes             String?  @db.Text
  performedAt       DateTime @default(now())
  reviewedById      Int?
  reviewedAt        DateTime?
  reviewApproved    Boolean?
  reviewNotes       String?  @db.Text
  outputItemId      Int?

  reject       WipReject         @relation(fields: [rejectId], references: [id], onDelete: Restrict)
  performedBy User              @relation("WipRejectRepairPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)
  reviewedBy  User?             @relation("WipRejectRepairReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  outputItem  Item?             @relation("WipRejectRepairOutput", fields: [outputItemId], references: [id], onDelete: Restrict)
  lots        WipRejectRepairLot[]

  @@index([rejectId, performedAt])
  @@index([performedById])
  @@index([reviewedById])
  @@index([outputItemId])
}

model WipRejectRepairLot {
  id          Int     @id @default(autoincrement())
  attemptId   Int
  rejectLotId Int
  quantity    Decimal @db.Decimal(18, 6)

  attempt   WipRejectRepairAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  rejectLot WipRejectLot           @relation(fields: [rejectLotId], references: [id], onDelete: Restrict)

  @@unique([attemptId, rejectLotId])
  @@index([rejectLotId])
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  divisiId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleRef              Role                  @relation("UserRole", fields: [role], references: [kode], onDelete: Restrict)
  divisi               Divisi?               @relation(fields: [divisiId], references: [id], onDelete: SetNull)
  riwayatMutasiGudang  RiwayatMutasiGudang[]
  stokItemMutasi       StokItemMutasi[]
  stokOpnameSesi       StokOpnameSesi[]
  pemakaianMaterials   PemakaianMaterial[]
  wipTransferDibuat    WipTransfer[]         @relation("WipTransferDibuat")
  wipTransferDisetujui WipTransfer[]         @relation("WipTransferDisetujui")
  inventoryMovements  InventoryMovement[]  @relation("InventoryMovementCreatedBy")
  qualityInspections  QualityInspection[]  @relation("QualityInspectionInspector")
  repairAssignments   RepairAssignment[]   @relation("RepairAssignmentAssignedBy")
  repairReviews       RepairAssignment[]   @relation("RepairAssignmentReviewedBy")
  repairAttempts      RepairAttempt[]      @relation("RepairAttemptPerformedBy")
  repairAttemptReviews RepairAttempt[]     @relation("RepairAttemptReviewedBy")
  shipments           CustomerShipment[]   @relation("CustomerShipmentCreatedBy")
  shipmentPosts       CustomerShipment[]   @relation("CustomerShipmentPostedBy")
  shipmentReturns     ShipmentReturn[]     @relation("ShipmentReturnReceivedBy")
  finishedGoodsReceipts FinishedGoodsReceipt[] @relation("FinishedGoodsReceiptReceivedBy")
  wipStocktakes         WipStocktakeSession[] @relation("WipStocktakeCountedBy")
  qualityRejectReasons  QualityRejectReason[] @relation("QualityRejectReasonCreatedBy")
  wipRejectsRecorded    WipReject[]           @relation("WipRejectRecordedBy")
  wipRejectsClaimed     WipReject[]           @relation("WipRejectClaimedBy")
  wipRejectAttempts     WipRejectRepairAttempt[] @relation("WipRejectRepairPerformedBy")
  wipRejectReviews      WipRejectRepairAttempt[] @relation("WipRejectRepairReviewedBy")

  @@index([role], map: "User_role_fkey")
  @@index([divisiId], map: "User_divisiId_fkey")
}

// =============================================
// RBAC: role master + permission master + matriks akses
// Kode role/permission disimpan lowercase; input API dinormalisasi
// supaya "ADMIN" dan "admin" menunjuk role yang sama.
// =============================================

model Role {
  id        Int      @id @default(autoincrement())
  kode      String   @unique
  nama      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]                       @relation("UserRole")
  permissions  RolePermission[]
  barangStatus RoleBarangStatusPermission[]
}

model Permission {
  id        Int      @id @default(autoincrement())
  kode      String   @unique
  nama      String
  kelompok  String   @default("BARANG")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
}

// Grant permission tingkat aksi ke sebuah role. Baris hilang otomatis saat
// role atau permission dihapus.
model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "RolePermission_permissionId_fkey")
}

// Visibilitas per status barang. STATUS_ADMIN (lihat middleware/auth.ts)
// melewati matriks ini dan selalu melihat semua status.
model RoleBarangStatusPermission {
  roleId     Int
  statusKode String
  canView    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  role   Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  status StatusBarang @relation(fields: [statusKode], references: [kode], onDelete: Cascade)

  @@id([roleId, statusKode])
  @@index([statusKode], map: "RoleBarangStatusPermission_statusKode_fkey")
}

model Product {
  id        Int      @id @default(autoincrement())
  nama      String
  prefix    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model Style {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model Color {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model Karyawan {
  id        Int      @id @default(autoincrement())
  nama      String
  jabatan   String
  divisiId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  divisi Divisi? @relation(fields: [divisiId], references: [id], onDelete: SetNull)

  @@index([divisiId])
}

// Divisi lini produksi (1:1 dengan tahap jadwal: buffing, baseCoat, ...).
// Dipakai pengelompokan karyawan dan pembuatan SPK per divisi.
model Divisi {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  karyawan            Karyawan[]
  items               Item[]
  users               User[]
  pemakaianMaterials  PemakaianMaterial[]
  hasilProduksiHarian HasilProduksiHarian[]
  permintaanPeminta   PermintaanBarang[]    @relation("PermintaanPeminta")
  permintaanApprover  PermintaanBarang[]    @relation("PermintaanApprover")
  wipTransferAsal     WipTransfer[]         @relation("WipTransferAsal")
  wipTransferTujuan   WipTransfer[]         @relation("WipTransferTujuan")
  inventoryLocations  InventoryLocation[]
  qcDefectsFound      QualityDefect[]       @relation("QualityDefectFoundAt")
  qcDefectsOrigin     QualityDefect[]       @relation("QualityDefectOriginDivision")
  qcDefectsRepair     QualityDefect[]       @relation("QualityDefectRepairDivision")
  repairAssignments   RepairAssignment[]
  productionRoutingStages ProductionRoutingStage[]
  wipRejectsForRepair     WipReject[]
}

model Item {
  id        Int      @id @default(autoincrement())
  kode      String   @unique
  nama      String
  divisiId  Int?
  unit      String   @default("pcs")
  jenis     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  divisi                   Divisi?                   @relation(fields: [divisiId], references: [id], onDelete: SetNull)
  permintaanItems          PermintaanBarangItem[]
  pemakaianMaterialItems   PemakaianMaterialItem[]
  stokMutasi               StokItemMutasi[]
  opnameBaris              StokOpnameBaris[]
  bomItems                 BomItem[]
  subassembly              Subassembly?
  hasilProduksiHarianItems HasilProduksiHarianItem[]
  wipTransferItems         WipTransferItem[]
  inventoryMovements       InventoryMovement[]
  productionRoutingInputs  ProductionRoutingStageInput[]
  productionRoutingOutputs ProductionRoutingStageOutput[]
  wipStocktakeLines        WipStocktakeLine[]
  wipRejects               WipReject[]
  wipRejectRepairOutputs WipRejectRepairAttempt[] @relation("WipRejectRepairOutput")

  @@index([divisiId], map: "Item_divisiId_fkey")
}

// =============================================
// Master Gudang (lokasi penyimpanan)
// Jumlah barang dihitung via _count, bukan kolom stok.
// =============================================

model Gudang {
  id        Int      @id @default(autoincrement())
  kode      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barang       Barang[]
  mutasiKeluar RiwayatMutasiGudang[] @relation("MutasiGudangAsal")
  mutasiMasuk  RiwayatMutasiGudang[] @relation("MutasiGudangTujuan")
  inventoryLocations InventoryLocation[]
}

// Riwayat perpindahan lokasi barang. Append-only: tidak ada
// endpoint ubah/hapus; koreksi dilakukan lewat mutasi balik.
model RiwayatMutasiGudang {
  id             Int      @id @default(autoincrement())
  barangId       Int
  gudangAsalId   Int?
  gudangTujuanId Int?
  jumlah         Int      @default(1)
  tanggal        DateTime @default(now())
  keterangan     String?
  userId         Int?
  createdAt      DateTime @default(now())

  barang       Barang  @relation(fields: [barangId], references: [id], onDelete: Restrict)
  gudangAsal   Gudang? @relation("MutasiGudangAsal", fields: [gudangAsalId], references: [id], onDelete: SetNull)
  gudangTujuan Gudang? @relation("MutasiGudangTujuan", fields: [gudangTujuanId], references: [id], onDelete: SetNull)
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([barangId, tanggal])
  @@index([gudangAsalId], map: "RiwayatMutasiGudang_gudangAsalId_fkey")
  @@index([gudangTujuanId], map: "RiwayatMutasiGudang_gudangTujuanId_fkey")
  @@index([userId], map: "RiwayatMutasiGudang_userId_fkey")
}

model Size {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]
}

model ProductVariant {
  id          Int    @id @default(autoincrement())
  kodeVariant String @unique

  productId Int
  styleId   Int
  colorId   Int
  sizeId    Int

  tanggal DateTime? @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  style   Style   @relation(fields: [styleId], references: [id], onDelete: Restrict)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Restrict)
  size    Size    @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  barang             Barang[]
  barangCounters     BarangCounter[]
  orderItems         ProductionOrderItem[]
  realizations       ProductionRealization[]
  qualityInspectionLines QualityInspectionLine[]
  scheduleAllocEdits ProductionScheduleAllocEdit[]
  boms               Bom[]
  subassemblies      Subassembly[]

  @@unique([productId, styleId, colorId, sizeId])
  @@index([productId])
  @@index([styleId])
  @@index([colorId])
  @@index([sizeId])
}

// =============================================
// Production Batch
// =============================================

enum StatusBatch {
  AKTIF
  SELESAI
}

model ProductionBatch {
  id            Int         @id @default(autoincrement())
  nomorBatch    Int         @unique
  totalProduksi Int         @default(0)
  kapasitas     Int         @default(5000)
  status        StatusBatch @default(AKTIF)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  barang         Barang[]
  barangCounters BarangCounter[]

  @@index([status])
}

// =============================================
// Status Barang (master dinamis — CRUD via /api/status-barang)
// =============================================

model StatusBarang {
  id        Int      @id @default(autoincrement())
  kode      String   @unique
  nama      String
  warna     String?
  urutan    Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barang          Barang[]                     @relation("BarangStatus")
  riwayat         RiwayatBarang[]              @relation("RiwayatStatus")
  transisiDari    StatusTransition[]           @relation("TransitionFrom")
  transisiKe      StatusTransition[]           @relation("TransitionTo")
  rolePermissions RoleBarangStatusPermission[]
}

// Transisi status barang yang diizinkan. Kosong untuk suatu fromKode =
// transisi dari status itu diizinkan ke semua (lihat model/barang).
model StatusTransition {
  id       Int    @id @default(autoincrement())
  fromKode String
  toKode   String

  from StatusBarang @relation("TransitionFrom", fields: [fromKode], references: [kode], onDelete: Cascade)
  to   StatusBarang @relation("TransitionTo", fields: [toKode], references: [kode], onDelete: Cascade)

  @@unique([fromKode, toKode])
  @@index([fromKode])
  @@index([toKode])
}

// =============================================
// Grup barang (1 grup = banyak barang)
// =============================================

model BarangGroup {
  id        Int      @id @default(autoincrement())
  nama      String
  isArsip   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barang Barang[]
}

model Barang {
  id         Int       @id @default(autoincrement())
  kodeBarang String    @unique
  variantId  Int
  batchId    Int?
  groupId    Int?
  gudangId   Int?
  qualityInspectionLineId Int?
  tanggal    DateTime?
  status     String    @default("REGISTER")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant             ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batch               ProductionBatch?      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  group               BarangGroup?          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  gudang              Gudang?               @relation(fields: [gudangId], references: [id], onDelete: SetNull)
  qualityInspectionLine   QualityInspectionLine?  @relation("QualityLineProduced", fields: [qualityInspectionLineId], references: [id], onDelete: Restrict)
  qualityLinesAsTarget    QualityInspectionLine[] @relation("QualityLineTarget")
  inventoryMovements      InventoryMovement[]
  finishedGoodsReceiptLines FinishedGoodsReceiptLine[]
  statusRef           StatusBarang          @relation("BarangStatus", fields: [status], references: [kode])
  riwayat             RiwayatBarang[]
  riwayatMutasiGudang RiwayatMutasiGudang[]
  shipmentLines       CustomerShipmentLine[]

  @@index([variantId])
  @@index([batchId])
  @@index([groupId])
  @@index([gudangId], map: "Barang_gudangId_fkey")
  @@index([qualityInspectionLineId])
  @@index([status])
}

model RiwayatBarang {
  id         Int      @id @default(autoincrement())
  barangId   Int
  status     String
  tanggal    DateTime @default(now())
  keterangan String?

  barang    Barang       @relation(fields: [barangId], references: [id], onDelete: Restrict)
  statusRef StatusBarang @relation("RiwayatStatus", fields: [status], references: [kode])

  @@index([barangId])
  @@index([tanggal])
  @@index([status], map: "RiwayatBarang_status_fkey")
}

// =============================================
// BarangCounter
// Key: (batchId, variantId, tanggal)
// Reset otomatis karena tanggal/batch berbeda = baris baru
// =============================================

model BarangCounter {
  id           Int      @id @default(autoincrement())
  batchId      Int
  variantId    Int
  tanggal      DateTime
  currentCount Int      @default(0)

  batch   ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([batchId, variantId, tanggal])
  @@index([batchId])
  @@index([variantId])
}

// =============================================
// Production Order (Master Produksi)
// Sumber: Google Sheet "DATA MASTER PRODUKSI OKTOBER 2026"
// 1 order = 1 periode, N item (1 baris = 1 ProductVariant + qty)
// =============================================

enum StatusProductionOrder {
  DRAFT
  AKTIF
  SELESAI
  BATAL
}

model ProductionOrder {
  id            Int                   @id @default(autoincrement())
  nomor         String                @unique
  periode       String
  label         String?
  totalQty      Int                   @default(0)
  status        StatusProductionOrder @default(AKTIF)
  mulaiProduksi DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  items               ProductionOrderItem[]
  capacities          ProductionCapacity[]
  realizations        ProductionRealization[]
  realizationStages   ProductionRealizationStage[]
  scheduleTargetEdits ProductionScheduleTargetEdit[]
  scheduleAllocEdits  ProductionScheduleAllocEdit[]
  hasilProduksiHarian HasilProduksiHarian[]

  @@index([periode])
  @@index([status])
}

model ProductionOrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  variantId Int
  qty       Int      @default(0)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([orderId])
  @@index([variantId])
}

// =============================================
// Realisasi produksi harian per item variant.
// 1 baris = aktual pcs 1 variant pada 1 tanggal dalam 1 order.
// Rencana harian dibaca dari jadwal (GET schedule), bukan disimpan.
// =============================================

model ProductionRealization {
  id        Int      @id @default(autoincrement())
  orderId   Int
  variantId Int
  tanggal   DateTime
  qty       Int      @default(0)
  reject    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId, tanggal])
  @@index([orderId, tanggal])
  @@index([variantId], map: "ProductionRealization_variantId_fkey")
}

// Realisasi harian per tahap lini (agregat per hari, bukan per variant).
// stage: buffing | baseCoat | decalSolid | decalMotif | topCoat | perakitan | qc.

model ProductionRealizationStage {
  id        Int      @id @default(autoincrement())
  orderId   Int
  tanggal   DateTime
  stage     String
  qty       Int      @default(0)
  reject    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, tanggal, stage])
  @@index([orderId, tanggal])
}

// =============================================
// Kapasitas Produksi per tahap per order
// Field 1:1 dengan sheet "PERHITUNGAN KAPASITAS PRODUKSI".
// hariKerja & totalKapasitas disimpan mentah (input manual),
// bukan hasil kalkulasi backend.
// =============================================

model ProductionCapacity {
  id               Int       @id @default(autoincrement())
  orderId          Int
  stage            String
  kapasitasWeekday Int       @default(0)
  kapasitasSabtu   Int       @default(0)
  mulai            DateTime?
  selesai          DateTime?
  hariKerja        Int       @default(0)
  totalKapasitas   Int       @default(0)
  catatan          String?
  urutan           Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, stage])
  @@index([orderId])
}

// =============================================
// Override edit jadwal otomatis per order.
// buildSchedule tetap mesin hitung; GET schedule menerapkan delta ini.
// qty null tidak disimpan — hapus baris = kembali ke angka auto.
// =============================================

model ProductionScheduleTargetEdit {
  id        Int      @id @default(autoincrement())
  orderId   Int
  tanggal   DateTime
  stage     String
  qty       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, tanggal, stage])
  @@index([orderId, tanggal])
}

model ProductionScheduleAllocEdit {
  id        Int      @id @default(autoincrement())
  orderId   Int
  variantId Int
  tanggal   DateTime
  qty       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, tanggal, variantId])
  @@index([orderId, tanggal])
  @@index([variantId], map: "ProductionScheduleAllocEdit_variantId_fkey")
}

enum StatusApprovalPermintaan {
  BELUM_DISETUJUI
  DISETUJUI
}

enum SumberPermintaanBarang {
  MANUAL
  HASIL_PRODUKSI
}

enum SumberPemakaianMaterial {
  PERMINTAAN_BARANG
  HASIL_PRODUKSI
  TRANSFER_WIP
  REPAIR
  OPNAME
}

enum StatusWipTransfer {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

enum ArahWipTransfer {
  KIRIM
  MINTA
}

enum StatusKeputusanItem {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

enum TipeStokItem {
  MASUK
  KELUAR
}

// Ledger stok item master (append-only). Saldo = SUM(MASUK) - SUM(KELUAR).
// Koreksi dilakukan dengan baris pembalik, tidak pernah ubah/hapus.
model StokItemMutasi {
  id                        Int          @id @default(autoincrement())
  itemId                    Int
  tipe                      TipeStokItem
  jumlah                    Int
  sumberPermintaanItemId    Int?
  sumberOpnameBarisId       Int?
  sumberHasilProduksiItemId Int?         @unique
  keterangan                String?
  userId                    Int?
  tanggal                   DateTime     @default(now())
  createdAt                 DateTime     @default(now())

  item                Item                     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  sumberPermintaan    PermintaanBarangItem?    @relation(fields: [sumberPermintaanItemId], references: [id], onDelete: SetNull)
  sumberOpname        StokOpnameBaris?         @relation(fields: [sumberOpnameBarisId], references: [id], onDelete: SetNull)
  sumberHasilProduksi HasilProduksiHarianItem? @relation(fields: [sumberHasilProduksiItemId], references: [id], onDelete: SetNull)
  user                User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId, tanggal])
  @@index([sumberPermintaanItemId], map: "StokItemMutasi_sumberPermintaanItemId_fkey")
  @@index([sumberOpnameBarisId], map: "StokItemMutasi_sumberOpnameBarisId_fkey")
  @@index([userId], map: "StokItemMutasi_userId_fkey")
}

// Stok opname massal: satu sesi berisi banyak baris hitung fisik.
// Baris selalu disimpan (termasuk selisih 0) sebagai bukti sudah dihitung.
// Selisih != 0 otomatis membuat baris ledger penyeimbang (MASUK/KELUAR).
model StokOpnameSesi {
  id         Int      @id @default(autoincrement())
  tanggal    DateTime @default(now())
  keterangan String?
  userId     Int?
  createdAt  DateTime @default(now())

  user  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  baris StokOpnameBaris[]

  @@index([tanggal])
  @@index([userId], map: "StokOpnameSesi_userId_fkey")
}

model StokOpnameBaris {
  id         Int @id @default(autoincrement())
  sesiId     Int
  itemId     Int
  stokSistem Int
  stokFisik  Int
  selisih    Int

  sesi   StokOpnameSesi   @relation(fields: [sesiId], references: [id], onDelete: Cascade)
  item   Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  ledger StokItemMutasi[]

  @@unique([sesiId, itemId])
  @@index([itemId], map: "StokOpnameBaris_itemId_fkey")
}

// Permintaan barang/bahan baku dari departemen ke gudang (form FRM-PRD-001).
// Item bebas teks (bukan FK ProductVariant) karena dapat berupa bahan baku
// yang tidak ada di master variant.
model PermintaanBarang {
  id                Int                      @id @default(autoincrement())
  noPermintaan      String                   @unique
  tanggal           DateTime
  departemen        String
  divisiPemintaId   Int?
  divisiApproverId  Int?
  namaPeminta       String
  kebutuhanUntuk    String                   @default("Produksi")
  prioritas         String                   @default("Normal")
  tanggalDibutuhkan DateTime?
  alasan            String                   @db.Text
  approval          StatusApprovalPermintaan @default(BELUM_DISETUJUI)
  sumber            SumberPermintaanBarang   @default(MANUAL)
  autoKey           String?                  @unique
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  divisiPeminta  Divisi?                @relation("PermintaanPeminta", fields: [divisiPemintaId], references: [id], onDelete: SetNull)
  divisiApprover Divisi?                @relation("PermintaanApprover", fields: [divisiApproverId], references: [id], onDelete: SetNull)
  items          PermintaanBarangItem[]

  pemakaianMaterials PemakaianMaterial[]

  @@index([tanggal])
  @@index([approval])
  @@index([divisiPemintaId], map: "PermintaanBarang_divisiPemintaId_fkey")
  @@index([divisiApproverId], map: "PermintaanBarang_divisiApproverId_fkey")
  @@index([sumber])
}

model PermintaanBarangItem {
  id              Int                 @id @default(autoincrement())
  permintaanId    Int
  itemId          Int?
  nama            String
  spesifikasi     String?
  jumlah          Int
  satuan          String?
  statusKeputusan StatusKeputusanItem @default(MENUNGGU)
  jumlahDisetujui Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  permintaan             PermintaanBarang        @relation(fields: [permintaanId], references: [id], onDelete: Cascade)
  item                   Item?                   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  stokMutasi             StokItemMutasi[]
  pemakaianMaterialItems PemakaianMaterialItem[]

  @@index([permintaanId], map: "PermintaanBarangItem_permintaanId_fkey")
  @@index([itemId], map: "PermintaanBarangItem_itemId_fkey")
}

// =============================================
// Bill of Materials (BOM) bertingkat
// Output: ProductVariant (produk jadi) atau Subassembly (semi-finished)
// Komponen: Item (material/komponen) atau Subassembly lain.
// =============================================

model Subassembly {
  id               Int      @id @default(autoincrement())
  kode             String   @unique
  nama             String
  itemId           Int?     @unique
  productVariantId Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  item           Item?           @relation(fields: [itemId], references: [id], onDelete: SetNull)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  bomAsOutput    Bom[]           @relation("BomOutput")
  usedInBomItems BomItem[]       @relation("BomItemComponent")

  @@index([itemId])
  @@index([productVariantId])
}

model Bom {
  id               Int       @id @default(autoincrement())
  kode             String?   @unique
  nama             String
  version          String
  isActive         Boolean   @default(true)
  berlakuMulai     DateTime?
  berlakuSelesai   DateTime?
  productVariantId Int?
  subassemblyId    Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  subassembly    Subassembly?    @relation("BomOutput", fields: [subassemblyId], references: [id], onDelete: Restrict)
  items          BomItem[]

  @@unique([productVariantId, version])
  @@unique([subassemblyId, version])
  @@index([productVariantId])
  @@index([subassemblyId])
  @@index([isActive])
}

model BomItem {
  id            Int      @id @default(autoincrement())
  bomId         Int
  urutan        Int?
  itemId        Int?
  subassemblyId Int?
  quantity      Decimal  @db.Decimal(18, 6)
  unit          String?
  scrapPercent  Decimal? @db.Decimal(5, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bom  Bom   @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item Item? @relation(fields: [itemId], references: [id], onDelete: Restrict)

  subassembly Subassembly? @relation("BomItemComponent", fields: [subassemblyId], references: [id], onDelete: Restrict)

  @@index([bomId])
  @@index([itemId])
  @@index([subassemblyId])
}

model PemakaianMaterial {
  id                    Int                     @id @default(autoincrement())
  nomor                 String                  @unique
  permintaanId          Int?
  divisiId              Int
  tanggal               DateTime                @default(now())
  userId                Int?
  sumber                SumberPemakaianMaterial @default(PERMINTAAN_BARANG)
  hasilProduksiHarianId Int?                    @unique
  wipTransferId         Int?                    @unique
  keterangan            String?                 @db.Text
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  permintaan          PermintaanBarang?       @relation(fields: [permintaanId], references: [id], onDelete: Restrict)
  divisi              Divisi                  @relation(fields: [divisiId], references: [id], onDelete: Restrict)
  user                User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  hasilProduksiHarian HasilProduksiHarian?    @relation(fields: [hasilProduksiHarianId], references: [id], onDelete: Restrict)
  wipTransfer         WipTransfer?            @relation(fields: [wipTransferId], references: [id], onDelete: Restrict)
  items               PemakaianMaterialItem[]

  @@index([permintaanId])
  @@index([divisiId, tanggal])
  @@index([userId])
}

model PemakaianMaterialItem {
  id                        Int      @id @default(autoincrement())
  pemakaianId               Int
  permintaanBarangItemId    Int?
  itemId                    Int?
  hasilProduksiHarianItemId Int?     @unique
  jumlahDiterima            Decimal  @default(0) @db.Decimal(18, 6)
  jumlahDipakai             Decimal  @default(0) @db.Decimal(18, 6)
  jumlahSisa                Decimal  @default(0) @db.Decimal(18, 6)
  satuan                    String?
  keteranganSisa            String?  @db.Text
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  pemakaian               PemakaianMaterial        @relation(fields: [pemakaianId], references: [id], onDelete: Cascade)
  permintaanItem          PermintaanBarangItem?    @relation(fields: [permintaanBarangItemId], references: [id], onDelete: Restrict)
  item                    Item?                    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  hasilProduksiHarianItem HasilProduksiHarianItem? @relation(fields: [hasilProduksiHarianItemId], references: [id], onDelete: Restrict)
  wipTransferItem         WipTransferItem?         @relation("WipTransferItemTujuan")
  hasilProduksiPemakaian  HasilProduksiPemakaian[]
  wipTransferAlokasi      WipTransferAlokasi[]     @relation("WipTransferSumber")
  inventoryMovements      InventoryMovement[]
  qualityInspectionLines  QualityInspectionLine[]
  wipRejectLots           WipRejectLot[]

  @@index([pemakaianId])
  @@index([permintaanBarangItemId])
  @@index([itemId])
}

model WipTransfer {
  id             Int               @id @default(autoincrement())
  nomor          String            @unique
  tanggal        DateTime          @default(now())
  divisiAsalId   Int
  divisiTujuanId Int
  arah           ArahWipTransfer  @default(KIRIM)
  status         StatusWipTransfer @default(MENUNGGU)
  userId         Int?
  approvedById   Int?
  approvedAt     DateTime?
  keterangan     String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  divisiAsal        Divisi             @relation("WipTransferAsal", fields: [divisiAsalId], references: [id], onDelete: Restrict)
  divisiTujuan      Divisi             @relation("WipTransferTujuan", fields: [divisiTujuanId], references: [id], onDelete: Restrict)
  user              User?              @relation("WipTransferDibuat", fields: [userId], references: [id], onDelete: SetNull)
  approvedBy        User?              @relation("WipTransferDisetujui", fields: [approvedById], references: [id], onDelete: SetNull)
  items             WipTransferItem[]
  pemakaianMaterial PemakaianMaterial?

  @@index([tanggal])
  @@index([divisiAsalId, tanggal])
  @@index([divisiTujuanId, tanggal])
  @@index([status])
  @@index([userId], map: "WipTransfer_userId_fkey")
  @@index([approvedById], map: "WipTransfer_approvedById_fkey")
}

model WipTransferItem {
  id                      Int      @id @default(autoincrement())
  transferId              Int
  itemId                  Int
  jumlah                  Int
  satuan                  String?
  jumlahDisetujui         Int?
  pemakaianMaterialItemId Int?     @unique
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  transfer              WipTransfer            @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item                  Item                   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  pemakaianMaterialItem PemakaianMaterialItem? @relation("WipTransferItemTujuan", fields: [pemakaianMaterialItemId], references: [id], onDelete: Restrict)
  alokasi               WipTransferAlokasi[]

  @@unique([transferId, itemId])
  @@index([itemId], map: "WipTransferItem_itemId_fkey")
}

model WipTransferAlokasi {
  id                      Int      @id @default(autoincrement())
  transferItemId          Int
  pemakaianMaterialItemId Int
  jumlah                  Decimal  @db.Decimal(18, 6)
  createdAt               DateTime @default(now())

  transferItem          WipTransferItem       @relation(fields: [transferItemId], references: [id], onDelete: Cascade)
  pemakaianMaterialItem PemakaianMaterialItem @relation("WipTransferSumber", fields: [pemakaianMaterialItemId], references: [id], onDelete: Restrict)

  @@index([transferItemId], map: "WipTransferAlokasi_transferItemId_fkey")
  @@index([pemakaianMaterialItemId], map: "WipTransferAlokasi_pemakaianMaterialItemId_fkey")
}

// =============================================
// Hasil Produksi Harian
// Header transaksi + detail aktivitas MASUK/KELUAR/HASIL.
// Saldo stok tetap dihitung dari StokItemMutasi (append-only).
// =============================================

enum TipeHasilProduksiItem {
  MASUK
  KELUAR
  HASIL
}

model HasilProduksiHarian {
  id              Int      @id @default(autoincrement())
  nomor           String   @unique
  tanggalProduksi DateTime @default(now())
  divisiId        Int
  orderId         Int?
  keterangan      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  divisi            Divisi                    @relation(fields: [divisiId], references: [id], onDelete: Restrict)
  order             ProductionOrder?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items             HasilProduksiHarianItem[]
  pemakaianMaterial PemakaianMaterial?
  inventoryMovements InventoryMovement[]

  @@index([tanggalProduksi])
  @@index([divisiId, tanggalProduksi])
  @@index([orderId, tanggalProduksi])
  @@map("hasil_produksi_harian")
}

model HasilProduksiHarianItem {
  id                    Int                   @id @default(autoincrement())
  hasilProduksiHarianId Int
  itemId                Int
  tipe                  TipeHasilProduksiItem
  jumlah                Decimal               @db.Decimal(18, 6)
  keterangan            String?               @db.Text
  createdAt             DateTime              @default(now())

  hasilProduksiHarian   HasilProduksiHarian      @relation(fields: [hasilProduksiHarianId], references: [id], onDelete: Cascade)
  item                  Item                     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  stokMutasi            StokItemMutasi?
  pemakaian             HasilProduksiPemakaian[]
  pemakaianMaterialItem PemakaianMaterialItem?

  @@index([hasilProduksiHarianId])
  @@index([itemId])
  @@index([itemId, tipe])
  @@map("hasil_produksi_harian_item")
}

// Relasi konsumsi WIP: baris MASUK produksi memakai saldo PemakaianMaterialItem.
// Saldo WIP tetap di PemakaianMaterialItem.jumlahSisa; tabel ini hanya jejak konsumsi.
model HasilProduksiPemakaian {
  id                        Int      @id @default(autoincrement())
  hasilProduksiHarianItemId Int
  pemakaianMaterialItemId   Int
  jumlah                    Decimal  @db.Decimal(18, 6)
  createdAt                 DateTime @default(now())

  hasilProduksiHarianItem HasilProduksiHarianItem @relation(fields: [hasilProduksiHarianItemId], references: [id], onDelete: Cascade)
  pemakaianMaterialItem   PemakaianMaterialItem   @relation(fields: [pemakaianMaterialItemId], references: [id], onDelete: Restrict)

  @@unique([hasilProduksiHarianItemId, pemakaianMaterialItemId])
  @@index([pemakaianMaterialItemId], map: "HasilProduksiPemakaian_pemakaianMaterialItemId_fkey")
}

enum InventoryLocationType {
  WAREHOUSE
  DIVISION
}

enum InventoryMovementType {
  OPENING
  PRODUCTION
  TRANSFER
  QC
  REPAIR
  SHIPMENT
  RETURN
  ADJUSTMENT
  REVERSAL
}

enum QualityInspectionStatus {
  DRAFT
  COMPLETED
}

enum RepairAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
}

model ProductionRouting {
  id        Int      @id @default(autoincrement())
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages       ProductionRoutingStage[]
  qualityLines QualityInspectionLine[]

  @@index([isActive])
}

model ProductionRoutingStage {
  id          Int                    @id @default(autoincrement())
  routingId   Int
  stage       String                 @db.VarChar(80)
  sequence    Int
  divisiId    Int
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  routing    ProductionRouting            @relation(fields: [routingId], references: [id], onDelete: Cascade)
  divisi     Divisi                       @relation(fields: [divisiId], references: [id], onDelete: Restrict)
  inputItems ProductionRoutingStageInput[]
  outputItems ProductionRoutingStageOutput[]
  repairRejects WipReject[] @relation("WipRejectRepairStage")

  @@unique([routingId, sequence])
  @@index([divisiId])
}

model ProductionRoutingStageInput {
  id               Int @id @default(autoincrement())
  routingStageId   Int
  itemId           Int

  routingStage ProductionRoutingStage @relation(fields: [routingStageId], references: [id], onDelete: Cascade)
  item         Item                  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([routingStageId, itemId])
  @@index([itemId])
}

model ProductionRoutingStageOutput {
  id               Int @id @default(autoincrement())
  routingStageId   Int
  itemId           Int

  routingStage ProductionRoutingStage @relation(fields: [routingStageId], references: [id], onDelete: Cascade)
  item         Item                  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([routingStageId, itemId])
  @@index([itemId])
}

enum RepairAttemptOutcome {
  REPAIRED
  PARTIAL
  FAILED
}

enum CustomerShipmentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum ShipmentReturnStatus {
  RECEIVED
  INSPECTED
  REJECTED
}

model InventoryLocation {
  id        Int                   @id @default(autoincrement())
  code      String                @unique
  name      String
  type      InventoryLocationType
  gudangId  Int?                  @unique
  divisiId  Int?                  @unique
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  gudang   Gudang? @relation(fields: [gudangId], references: [id], onDelete: Restrict)
  divisi   Divisi? @relation(fields: [divisiId], references: [id], onDelete: Restrict)
  incoming InventoryMovement[] @relation("InventoryMovementDestination")
  outgoing InventoryMovement[] @relation("InventoryMovementSource")
  finishedGoodsReceipts FinishedGoodsReceipt[]
  customerShipments     CustomerShipment[]
  shipmentReturns       ShipmentReturn[]
  wipStocktakeSessions  WipStocktakeSession[]

  @@index([type, isActive])
}

model InventoryMovement {
  id                      BigInt                @id @default(autoincrement())
  itemId                  Int?
  barangId                Int?
  fromLocationId          Int?
  toLocationId            Int?
  pemakaianMaterialItemId Int?
  hasilProduksiHarianId   Int?
  type                    InventoryMovementType
  quantity                Decimal               @db.Decimal(18, 6)
  idempotencyKey          String                @unique
  sourceType              String
  sourceId                String
  reason                  String?               @db.Text
  userId                  Int?
  occurredAt              DateTime              @default(now())
  reversalOfId            BigInt?               @unique
  createdAt               DateTime              @default(now())

  item                  Item?                  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  barang                Barang?                @relation(fields: [barangId], references: [id], onDelete: Restrict)
  fromLocation          InventoryLocation?     @relation("InventoryMovementSource", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation            InventoryLocation?     @relation("InventoryMovementDestination", fields: [toLocationId], references: [id], onDelete: Restrict)
  pemakaianMaterialItem PemakaianMaterialItem? @relation(fields: [pemakaianMaterialItemId], references: [id], onDelete: Restrict)
  hasilProduksiHarian   HasilProduksiHarian?   @relation(fields: [hasilProduksiHarianId], references: [id], onDelete: Restrict)
  user                  User?                  @relation("InventoryMovementCreatedBy", fields: [userId], references: [id], onDelete: SetNull)
  reversalOf            InventoryMovement?    @relation("InventoryMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy            InventoryMovement?    @relation("InventoryMovementReversal")

  @@index([itemId, occurredAt])
  @@index([barangId, occurredAt])
  @@index([fromLocationId, itemId, occurredAt])
  @@index([fromLocationId, barangId, occurredAt])
  @@index([toLocationId, itemId, occurredAt])
  @@index([toLocationId, barangId, occurredAt])
  @@index([pemakaianMaterialItemId])
  @@index([hasilProduksiHarianId])
  @@index([sourceType, sourceId])
}

model WipStocktakeSession {
  id          Int      @id @default(autoincrement())
  number      String   @unique
  locationId  Int
  countedById Int
  notes       String?  @db.Text
  countedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  location  InventoryLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  countedBy User               @relation("WipStocktakeCountedBy", fields: [countedById], references: [id], onDelete: Restrict)
  lines     WipStocktakeLine[]

  @@index([locationId, countedAt])
  @@index([countedById, countedAt])
}

model WipStocktakeLine {
  id               Int      @id @default(autoincrement())
  sessionId        Int
  itemId           Int
  systemQuantity   Decimal  @db.Decimal(18, 6)
  physicalQuantity Decimal  @db.Decimal(18, 6)
  difference       Decimal  @db.Decimal(18, 6)
  reason           String   @db.Text
  createdAt        DateTime @default(now())

  session WipStocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  item    Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([sessionId, itemId])
  @@index([itemId, createdAt])
}

model QualityInspection {
  id             Int                    @id @default(autoincrement())
  number         String                 @unique
  status         QualityInspectionStatus @default(DRAFT)
  inspectedAt    DateTime               @default(now())
  inspectorId    Int
  reopenedFromId Int?
  reopenReason   String?                @db.Text
  notes          String?                @db.Text
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  inspector    User                 @relation("QualityInspectionInspector", fields: [inspectorId], references: [id], onDelete: Restrict)
  reopenedFrom QualityInspection?  @relation("QualityInspectionReopened", fields: [reopenedFromId], references: [id], onDelete: Restrict)
  reopenedAs   QualityInspection[] @relation("QualityInspectionReopened")
  lines        QualityInspectionLine[]

  @@index([status, inspectedAt])
  @@index([inspectorId])
  @@index([reopenedFromId])
}

model QualityInspectionLine {
  id                      Int      @id @default(autoincrement())
  inspectionId            Int
  pemakaianMaterialItemId  Int?
  barangId                 Int?
  reopenedFromLineId       Int?
  repairAttemptId          Int?     @unique
  productionRoutingId      Int?
  productVariantId         Int?
  inspectedQuantity        Decimal  @db.Decimal(18, 6)
  passedQuantity           Decimal  @default(0) @db.Decimal(18, 6)
  repairQuantity           Decimal  @default(0) @db.Decimal(18, 6)
  rejectedQuantity         Decimal  @default(0) @db.Decimal(18, 6)
  createdAt                DateTime @default(now())

  inspection  QualityInspection     @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  lot         PemakaianMaterialItem? @relation(fields: [pemakaianMaterialItemId], references: [id], onDelete: Restrict)
  barangTarget Barang?                @relation("QualityLineTarget", fields: [barangId], references: [id], onDelete: Restrict)
  reopenedFrom QualityInspectionLine? @relation("QualityInspectionLineReopened", fields: [reopenedFromLineId], references: [id], onDelete: Restrict)
  repairAttempt RepairAttempt?        @relation(fields: [repairAttemptId], references: [id], onDelete: Restrict)
  productionRouting ProductionRouting? @relation(fields: [productionRoutingId], references: [id], onDelete: Restrict)
  reopenedAs  QualityInspectionLine[] @relation("QualityInspectionLineReopened")
  variant     ProductVariant?       @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  defects     QualityDefect[]
  producedBarang Barang[]           @relation("QualityLineProduced")
  assignments RepairAssignment[]
  fgReceiptLines FinishedGoodsReceiptLine[]

  @@index([inspectionId])
  @@index([pemakaianMaterialItemId])
  @@index([barangId])
  @@index([reopenedFromLineId])
  @@index([productionRoutingId])
  @@index([productVariantId])
}

model QualityDefect {
  id                Int      @id @default(autoincrement())
  inspectionLineId  Int
  description       String   @db.Text
  quantity          Decimal  @db.Decimal(18, 6)
  foundAtDivisionId Int?
  originDivisionId  Int?
  repairDivisionId  Int?
  createdAt         DateTime @default(now())

  inspectionLine QualityInspectionLine @relation(fields: [inspectionLineId], references: [id], onDelete: Restrict)
  foundAt        Divisi?               @relation("QualityDefectFoundAt", fields: [foundAtDivisionId], references: [id], onDelete: SetNull)
  originDivision Divisi?               @relation("QualityDefectOriginDivision", fields: [originDivisionId], references: [id], onDelete: SetNull)
  repairDivision Divisi?               @relation("QualityDefectRepairDivision", fields: [repairDivisionId], references: [id], onDelete: SetNull)
  assignments    RepairAssignment[]

  @@index([inspectionLineId])
  @@index([foundAtDivisionId])
  @@index([originDivisionId])
  @@index([repairDivisionId])
}

model RepairAssignment {
  id               Int                    @id @default(autoincrement())
  inspectionLineId Int
  defectId         Int
  repairDivisionId Int
  quantity         Decimal                @db.Decimal(18, 6)
  status           RepairAssignmentStatus @default(ASSIGNED)
  assignedById     Int
  assignedAt       DateTime               @default(now())
  completedAt      DateTime?
  reviewedById     Int?
  reviewedAt       DateTime?
  reviewNotes      String?                @db.Text
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  inspectionLine QualityInspectionLine @relation(fields: [inspectionLineId], references: [id], onDelete: Restrict)
  defect         QualityDefect         @relation(fields: [defectId], references: [id], onDelete: Restrict)
  repairDivision Divisi                @relation(fields: [repairDivisionId], references: [id], onDelete: Restrict)
  assignedBy     User                  @relation("RepairAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  reviewedBy     User?                 @relation("RepairAssignmentReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  attempts       RepairAttempt[]

  @@index([repairDivisionId, status])
  @@index([inspectionLineId])
  @@index([defectId])
  @@index([assignedById])
  @@index([reviewedById])
}

model RepairAttempt {
  id                Int                 @id @default(autoincrement())
  assignmentId      Int
  performedById     Int
  outcome           RepairAttemptOutcome
  quantityAttempted Decimal             @db.Decimal(18, 6)
  quantityRepaired  Decimal             @default(0) @db.Decimal(18, 6)
  quantityRemaining Decimal             @default(0) @db.Decimal(18, 6)
  notes             String?             @db.Text
  performedAt       DateTime            @default(now())
  reviewedById      Int?
  reviewedAt        DateTime?
  reviewApproved    Boolean?
  reviewNotes       String?             @db.Text
  createdAt         DateTime            @default(now())

  assignment  RepairAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  performedBy User             @relation("RepairAttemptPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)
  reviewedBy  User?            @relation("RepairAttemptReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  inspectionLine QualityInspectionLine?

  @@index([assignmentId, performedAt])
  @@index([performedById])
  @@index([reviewedById])
}

model FinishedGoodsReceipt {
  id             Int      @id @default(autoincrement())
  number         String   @unique
  idempotencyKey String   @unique
  locationId     Int
  receivedById   Int
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  receivedBy User              @relation("FinishedGoodsReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  lines      FinishedGoodsReceiptLine[]

  @@index([locationId, receivedAt])
  @@index([receivedById])
}

model FinishedGoodsReceiptLine {
  id                      Int      @id @default(autoincrement())
  receiptId               Int
  qualityInspectionLineId Int
  barangId                Int
  createdAt               DateTime @default(now())

  receipt       FinishedGoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  qualityLine   QualityInspectionLine @relation(fields: [qualityInspectionLineId], references: [id], onDelete: Restrict)
  barang        Barang                @relation(fields: [barangId], references: [id], onDelete: Restrict)

  @@unique([receiptId, barangId])
  @@index([qualityInspectionLineId])
  @@index([barangId])
}

model CustomerShipment {
  id                  Int                    @id @default(autoincrement())
  number              String                 @unique
  idempotencyKey      String                 @unique
  fromLocationId      Int
  recipientName       String
  recipientAddress    String                 @db.Text
  reference           String?
  status              CustomerShipmentStatus @default(DRAFT)
  createdById         Int
  postedById          Int?
  shippedAt           DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?                @db.Text
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  createdBy User                  @relation("CustomerShipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy  User?                 @relation("CustomerShipmentPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  fromLocation InventoryLocation @relation(fields: [fromLocationId], references: [id], onDelete: Restrict)
  lines     CustomerShipmentLine[]
  returns   ShipmentReturn[]

  @@index([status, createdAt])
  @@index([createdById])
  @@index([postedById])
  @@index([fromLocationId, status])
}

model CustomerShipmentLine {
  id         Int      @id @default(autoincrement())
  shipmentId Int
  barangId   Int
  createdAt  DateTime @default(now())

  shipment CustomerShipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  barang   Barang           @relation(fields: [barangId], references: [id], onDelete: Restrict)
  returns  ShipmentReturnLine[]

  @@unique([shipmentId, barangId])
  @@index([barangId])
}

model ShipmentReturn {
  id           Int                 @id @default(autoincrement())
  number       String              @unique
  shipmentId   Int
  toLocationId Int
  idempotencyKey String @unique
  receivedById Int
  status       ShipmentReturnStatus @default(RECEIVED)
  receivedAt   DateTime            @default(now())
  reason       String              @db.Text
  createdAt    DateTime            @default(now())

  shipment   CustomerShipment    @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  toLocation InventoryLocation   @relation(fields: [toLocationId], references: [id], onDelete: Restrict)
  receivedBy User                @relation("ShipmentReturnReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  lines      ShipmentReturnLine[]

  @@index([shipmentId, receivedAt])
  @@index([receivedById])
  @@index([toLocationId, receivedAt])
}

model ShipmentReturnLine {
  id             Int      @id @default(autoincrement())
  returnId       Int
  shipmentLineId Int
  condition      String   @db.Text
  createdAt      DateTime @default(now())

  shipmentReturn ShipmentReturn       @relation(fields: [returnId], references: [id], onDelete: Restrict)
  shipmentLine   CustomerShipmentLine @relation(fields: [shipmentLineId], references: [id], onDelete: Restrict)

  @@unique([shipmentLineId])
  @@index([returnId])
}
