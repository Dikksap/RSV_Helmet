{
  "name": "express-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch api/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/api/index.js",
    "db:migrate": "docker exec -it backend-api-1 npx prisma migrate dev",
    "db:push": "docker exec -it backend-api-1 npx prisma db push",
    "db:studio": "docker exec -it backend-api-1 npx prisma studio",
    "db:seed": "docker exec -it backend-api-1 npx prisma db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.3",
    "prisma": "^7.9.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "tsx": "^4.15.0",
    "typescript": "^5.5.2",
    "vitest": "^4.1.11"
  }
}
